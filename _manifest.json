{
  "manifest_version": 2,
  "id": "com.liuc-c.qianqian-plugins",
  "version": "0.3.0",
  "name": "仟仟自用插件",
  "description": "为仟仟提供 QQ 群专属头衔与概率复读能力的 MaiBot 插件。",
  "author": {
    "name": "liuc-c",
    "url": "https://github.com/liuc-c"
  },
  "license": "UNLICENSED",
  "urls": {
    "repository": "https://github.com/liuc-c/qianqian-plugins"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.5.1",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "plugin",
      "id": "maibot-team.napcat-adapter",
      "version_spec": ">=1.0.1,<2.0.0"
    }
  ],
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "emoji",
      "value": "🐾"
    }
  },
  "capabilities": [
    "api.call",
    "message.get_by_id",
    "send.hybrid",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
